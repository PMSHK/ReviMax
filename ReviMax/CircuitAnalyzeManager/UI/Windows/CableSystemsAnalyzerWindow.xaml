<Window x:Class="ReviMax.CircuitAnalyzeManager.UI.Windows.CableSystemsAnalyzerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReviMax.CircuitAnalyzeManager.UI.Windows"
        xmlns:materialDesign ="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Анализатор кабельных систем" Height="auto"  Width="200">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ReviMax;component/UI/Resources/WindowElementsResource.xaml"/>
                <ResourceDictionary Source="/ReviMax;component/UI/Templates/GeneralButtonStyle.xaml"/>
                <ResourceDictionary Source="/ReviMax;component/UI/Templates/RmListStyle.xaml"/>
                <ResourceDictionary Source="/ReviMax;component/UI/Templates/LineItemTemplate.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Blue.xaml"/>

                <materialDesign:BundledTheme BaseTheme="Dark" 
                                        PrimaryColor="Blue" 
                                        SecondaryColor="Lime" />

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource Bg}">
        <Border Margin="{StaticResource AllSidesMargin}" 
                CornerRadius="{StaticResource WindowCornerRadius}" 
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="{StaticResource StandardBorderThickness}">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="{StaticResource AllSidesMargin}">
                <Button Style="{StaticResource RmButton}" Width="Auto" Height="Auto"  Content="Построить/Обновить" ToolTip="Строит математическую модель на основании кабельных систем Revit для дальнейшего взаимодействия. " Command="{Binding Graph}"/>
                <Button Style="{StaticResource RmButton}" Width="Auto" Height="Auto" Margin="{StaticResource TopMargin}" Content="Разместить выноски" ToolTip="Позволяет разместить марки кабельных кабельных трасс" Command="{Binding Marks}"/>
                <Button Style="{StaticResource RmButton}" Width="Auto" Height="Auto" Margin="{StaticResource TopMargin}" Content="Кабельный журнал" ToolTip="Позволяет создать кабельный журнал на основании полученных данных" Command="{Binding CableJournal}"/>
                <Button Style="{StaticResource RmButton}" Width="Auto" Height="Auto" Margin="{StaticResource TopMargin}" Content="Загруженность" ToolTip="Позволяет оценить загруженность кабельных трасс" Command="{Binding CableLoad}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
